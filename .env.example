# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your-gemini-api-key"

# Gemini model. Use the exact model name shown by GET /api/model-status.
GEMINI_MODEL="gemma-4-31b-it"

# Fast fallback used when the primary model is unavailable or returns invalid output.
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"

# Optional response/input limits. Lower values reduce latency for very long PDFs.
GEMINI_MAX_OUTPUT_TOKENS="8192"
MAX_MODEL_TEXT_CHARS="240000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: deployed Express API origin for GitHub Pages builds.
# Example: https://your-api.example.com
VITE_API_BASE_URL=""
